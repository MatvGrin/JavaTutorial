<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
 		http://www.springframework.org/schema/beans
 		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd">

    <bean id="consoleEventLogger" class="ua.mgrin.ConsoleEventLogger"/>

    <bean id="dateFormat" class="java.text.DateFormat" factory-method="getDateTimeInstance"/>

    <bean id="fileEventLogger" class="ua.mgrin.FileEventLogger" init-method="init">
        <constructor-arg value="D:\Logs\test.txt"/>
    </bean>

    <bean id="cacheFileEventLogger" class="ua.mgrin.CacheFileEventLogger" destroy-method="destroy" init-method="init">
        <constructor-arg index="0" value="D:\Logs\test.txt"/>
        <constructor-arg index="1" value="4"/>
    </bean>

    <bean id="combinedEventLogger" class="ua.mgrin.CombinedEventLogger">
        <constructor-arg>
            <list>
                <ref bean="consoleEventLogger"/>
                <ref bean="fileEventLogger"/>
            </list>
        </constructor-arg>
    </bean>

</beans>
