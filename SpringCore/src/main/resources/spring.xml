<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
 		http://www.springframework.org/schema/beans
 		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd">

    <import resource="loggers.xml"/>
    <import resource="springAspects.xml"/>
<!--    <import resource="springJDBC.xml"/>-->

    <bean id="client"
          class="ua.mgrin.Client">
        <constructor-arg value="1"/>
        <constructor-arg value="John Smith"/>
<!--        <property name="greeting" value="Hello there!"/>-->
    </bean>

    <bean id="app" class="ua.mgrin.App">
        <constructor-arg ref="client"/>
        <constructor-arg ref="cacheFileEventLogger"/>
        <constructor-arg>
            <map>
                <entry key="INFO" value-ref="consoleEventLogger"/>
                <entry key="ERROR" value-ref="combinedEventLogger"/>
            </map>
        </constructor-arg>
    </bean>

<!--    AOP-->
<!--    <bean id="logaspect" class="ua.mgrin.LoggingAspect"/> замінив анотацією Component-->

</beans>
