<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="aBreak" class="org.autowired.xml_by_name.Break"/>

    <bean id="dizelEngine" class="org.autowired.xml_by_name.DizelEngine"/>
    <bean id="petrolEngine" class="org.autowired.xml_by_name.PetrolEngine"/>

    <bean id="carByName" autowire="byName" class="org.autowired.xml_by_name.Car" lazy-init="true"/>

</beans>
