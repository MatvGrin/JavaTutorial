<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                                   http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="singer" class="org.injecting_dependencies_through_the_search_method_with_xml.Singer" scope="prototype"/>

    <bean id="abstractLookupDemoBean" class="org.injecting_dependencies_through_the_search_method_with_xml.AbstractLookupDemoBean">
        <lookup-method name="getMySinger" bean="singer"/>
    </bean>

    <bean id="standardLookupDemoBean" class="org.injecting_dependencies_through_the_search_method_with_xml.StandardLookupDemoBean">
        <property name="mySinger" ref="singer"/>
    </bean>

</beans>
