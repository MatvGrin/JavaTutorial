<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="fooOne"
          class="org.auto_linking_spring_beans_components.Foo"/>
    <bean id="barOne"
          class="org.auto_linking_spring_beans_components.Bar"/>
    <bean id="targetByName" autowire="byName"
          class="org.auto_linking_spring_beans_components.Target"
          lazy-init="true"/>
    <bean id="targetByType" autowire="byType"
          class="org.auto_linking_spring_beans_components.Target"
          lazy-init="true"/>
    <bean id="targetConstructor" autowire="constructor"
          class="org.auto_linking_spring_beans_components.Target"
          lazy-init="true"/>

</beans>
